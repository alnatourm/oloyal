<script>
  let currentTotal = 55.00;
  let customInputBuffer = "";

  function updateDisplays() {
    const formatted = currentTotal.toFixed(2);
    document.getElementById('dial-display').innerText = formatted;
    document.getElementById('ledger-total').innerText = '$' + formatted;
    document.getElementById('btn-total-val').innerText = '$' + formatted;
  }

  function setTender(amount) {
    currentTotal = amount;
    customInputBuffer = "";
    updateDisplays();
  }

  function adjustAmount(delta) {
    currentTotal = Math.max(0, currentTotal + delta);
    customInputBuffer = "";
    updateDisplays();
  }

  function pressKey(key) {
    if (key === 'C') {
      currentTotal = 0.00;
      customInputBuffer = "";
    } else if (key === 'DEL') {
      customInputBuffer = customInputBuffer.slice(0, -1);
      currentTotal = customInputBuffer ? parseFloat(customInputBuffer) : 0.00;
    } else if (key === '+10') {
      currentTotal += 10.00;
      customInputBuffer = "";
    } else if (key === '+20') {
      currentTotal += 20.00;
      customInputBuffer = "";
    } else {
      if (customInputBuffer.length < 7) {
        customInputBuffer += key;
        const parsed = parseFloat(customInputBuffer);
        if (!isNaN(parsed)) {
          currentTotal = parsed;
        }
      }
    }
    updateDisplays();
  }

  function togglePerk(buttonEl, discountVal) {
    const isActive = buttonEl.classList.contains('perk-active');
    if (isActive) {
      buttonEl.classList.remove('perk-active');
      buttonEl.classList.remove('tactile-deboss');
      buttonEl.classList.add('tactile-btn');
      currentTotal += discountVal;
    } else {
      buttonEl.classList.add('perk-active');
      buttonEl.classList.add('tactile-deboss');
      buttonEl.classList.remove('tactile-btn');
      currentTotal = Math.max(0, currentTotal - discountVal);
    }
    updateDisplays();
  }

  function executeCheckout() {
    const toast = document.getElementById('sync-toast');
    toast.classList.remove('translate-y-24', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    
    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 3800);
  }
</script></main></div></body></html>
      },
      {
        title: 'Live POS Webhook Stream',
        desc: 'Check #4819 accrued 140 pts via Toast API'
      }
    ];

    tabs.forEach((tab, i) => {
      if (i === index) {
        tab.classList.remove('bg-surface', 'shadow-[inset_2px_2px_5px_#d1d9e6,inset_-2px_-2px_5px_#ffffff]');
        tab.classList.add('bg-surface-container-lowest', 'shadow-[-4px_-4px_10px_#ffffff,4px_4px_10px_#d1d9e6]');
      } else {
        tab.classList.remove('bg-surface-container-lowest', 'shadow-[-4px_-4px_10px_#ffffff,4px_4px_10px_#d1d9e6]');
        tab.classList.add('bg-surface', 'shadow-[inset_2px_2px_5px_#d1d9e6,inset_-2px_-2px_5px_#ffffff]');
      }
    });

    if (states[index]) {
      title.innerText = states[index].title;
      desc.innerText = states[index].desc;
    }
  }

  // Interactive ROI Calculator Logic
  function calculateROI() {
    const locInput = document.getElementById('input-locations');
    const dinInput = document.getElementById('input-diners');
    const tickInput = document.getElementById('input-ticket');

    const locVal = parseInt(locInput.value);
    const dinVal = parseInt(dinInput.value);
    const tickVal = parseInt(tickInput.value);

    document.getElementById('val-locations').innerText = locVal + (locVal === 1 ? ' Store' : ' Stores');
    document.getElementById('val-diners').innerText = dinVal.toLocaleString() + ' Guests';
    document.getElementById('val-ticket').innerText = '$' + tickVal;

    // Model: 18% repeat visit lift on 20% enrolled diners = 3.6% incremental spend across total base
    const totalMonthlyDiners = locVal * dinVal * 30;
    const grossMonthlyVolume = totalMonthlyDiners * tickVal;
    const incrementalRevenue = Math.round(grossMonthlyVolume * 0.036);

    document.getElementById('output-revenue').innerText = '+$' + incrementalRevenue.toLocaleString();
  }

  // Dial Counter Animation

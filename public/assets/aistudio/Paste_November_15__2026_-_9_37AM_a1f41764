<span class="font-bold text-on-surface">Starts 5:00 PM</span>
</div>
<div class="pt-space-xs flex items-center justify-between">
<span class="font-label-sm text-[10px] text-on-surface-variant">Trigger: Boundary Entry</span>
<button class="w-7 h-7 rounded-full bg-surface-container-low shadow-[-2px_-2px_4px_#FFFFFF,2px_2px_4px_#D1D9E6] flex items-center justify-center text-on-surface-variant hover:text-primary" type="button">
<span class="material-symbols-outlined text-[14px]">tune</span>
</button>
</div>
</div>
</div>
</section>
</div>
<script>
  (function () {
    // 1. Live Input Sync with Android Lockscreen Preview
    const titleInput = document.getElementById('input-push-title');
    const bodyInput = document.getElementById('input-push-body');
    const previewTitle = document.getElementById('preview-title');
    const previewBody = document.getElementById('preview-body');
    const titleCharCount = document.getElementById('title-char-count');
    const bodyCharCount = document.getElementById('body-char-count');

    if (titleInput && previewTitle) {
      titleInput.addEventListener('input', function () {
        previewTitle.textContent = this.value || 'Banlis Bistro Notification';
        if (titleCharCount) titleCharCount.textContent = this.value.length + ' / 60';
      });
    }

    if (bodyInput && previewBody) {
      bodyInput.addEventListener('input', function () {
        previewBody.textContent = this.value || 'Tap your pass at Banlis Bistro.';
        if (bodyCharCount) bodyCharCount.textContent = this.value.length + ' / 140';
      });
    }

    // 2. Proximity Radius Stepper Interactivity
    const radiusButtons = document.querySelectorAll('.radius-toggle');
    const radiusText = document.getElementById('radius-text-value');
    const radarBadge = document.getElementById('map-radius-badge');
    const radarPulse = document.getElementById('radar-pulse-ring');

    radiusButtons.forEach(btn => {
      btn.addEventListener('click', function () {
        radiusButtons.forEach(b => {
          b.className = 'radius-toggle py-space-xs rounded-full font-label-sm text-label-sm text-on-surface-variant transition-all hover:text-on-surface flex flex-col items-center';
        });
        this.className = 'radius-toggle py-space-xs rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-primary shadow-[-2px_-2px_6px_#FFFFFF,2px_2px_6px_#D1D9E6] font-bold transition-all flex flex-col items-center';
        
        const rad = this.dataset.radius;
        if (radiusText) radiusText.textContent = rad + ' Meters';
        if (radarBadge) radarBadge.textContent = rad + 'm Active';

        if (radarPulse) {
          if (rad === '150') {
            radarPulse.style.width = '100px';
            radarPulse.style.height = '100px';
          } else if (rad === '300') {
            radarPulse.style.width = '160px';
            radarPulse.style.height = '160px';
          } else {
            radarPulse.style.width = '240px';
            radarPulse.style.height = '240px';
          }
        }
      });
    });

    // 3. Audience Segment Buttons Selection
    const audienceBtns = document.querySelectorAll('.audience-btn');
    audienceBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        audienceBtns.forEach(b => {
          b.className = 'audience-btn px-space-md py-space-xs rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all';
        });
        this.className = 'audience-btn px-space-md py-space-xs rounded-full font-label-md text-label-md bg-surface-container-lowest text-primary shadow-[-2px_-2px_5px_#FFFFFF,2px_2px_5px_#D1D9E6] transition-all';
      });
    });

    // 4. Test Push Notification Micro-interaction
    const testPushBtn = document.getElementById('btn-test-push');
    if (testPushBtn) {
      testPushBtn.addEventListener('click', function () {
        const origText = this.innerHTML;
        this.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">sync</span><span>Sent to Pixel 8 Pro!</span>';
        this.classList.add('text-primary');
        setTimeout(() => {
          this.innerHTML = origText;
          this.classList.remove('text-primary');
        }, 2200);
      });
    }

    // 5. Dispatch Primary Button Confirmation
    const dispatchBtn = document.getElementById('btn-dispatch');
    if (dispatchBtn) {
      dispatchBtn.addEventListener('click', function () {
        const origText = this.innerHTML;
        this.innerHTML = '<span class="material-symbols-outlined text-[18px]">verified</span><span>3,842 Beacons Active</span>';
        setTimeout(() => {
          this.innerHTML = origText;
        }, 2500);
      });
    }
  })();
</script></main></div></body></html>